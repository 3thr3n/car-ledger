{
  "name": "CarLedger: approve car requests",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "car-ledger",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "car-ledger"
    },
    {
      "parameters": {
        "jsCode": "// verifies X-CarLedger-Signature over the raw body, drops anything else\nconst crypto = require('crypto');\nconst secret = $env.CARLEDGER_WEBHOOK_SECRET;\nconst results = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const raw = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  const signature = item.json.headers['x-carledger-signature'] ?? '';\n  const valid = signature.length === expected.length\n    && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\n  const event = JSON.parse(raw.toString('utf8'));\n  if (valid && event.type === 'car-request.created') {\n    results.push({ json: event.data });\n  }\n}\nreturn results;"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "car-ledger@example.com",
        "sendTo": "admin@example.com",
        "subject": "=CarLedger: {{ $json.account }} requests {{ $json.cars }} more car(s)",
        "message": "={{ $json.account }} has {{ $json.maxCars }} car(s) and requests {{ $json.cars }} more.\nReason: {{ $json.reason ?? '-' }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "name": "Ask the admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://car-ledger.example.com/api/admin/car-requests/{{ $('Verify signature').item.json.requestId }}/approve",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "name": "Approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://car-ledger.example.com/api/admin/car-requests/{{ $('Verify signature').item.json.requestId }}/reject",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"comment\": \"Rejected in n8n\" }",
        "options": {}
      },
      "name": "Reject",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Verify signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify signature": {
      "main": [
        [
          {
            "node": "Ask the admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the admin": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Approve",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
